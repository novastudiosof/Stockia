# ==========================================================================
# Supabase — copia este archivo a .env.local y completa con los valores de
# tu proyecto (Supabase Dashboard > Project Settings > API).
# ==========================================================================

# URL pública del proyecto y llave anónima: se usan en el navegador, no son
# secretas (RLS es lo que protege los datos, no el secreto de esta llave).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx...

# Llave de servicio (service_role): SECRETA. Se salta RLS por completo.
# Solo se usa en el servidor (route handlers de superadmin, scripts de
# bootstrap). Nunca debe llegar al navegador ni a un repositorio público.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx...

# Bucket de Supabase Storage donde se guardan los archivos de facturas.
SUPABASE_INVOICES_BUCKET=invoices
